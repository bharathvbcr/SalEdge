# Server — use "auto" (or leave unset) to pick the first free port from 3001
PORT=auto
JWT_SECRET=change-me-to-a-long-random-string-in-production
DATABASE_PATH=./data/bsms.sqlite

# Set to true only for open self-registration (not recommended in production)
ALLOW_REGISTRATION=false

# --- Dev/testing only (client) ---
# The seeded test-login UI + auto-login bypass are auto-on during `vite dev`.
# For a BUILT bundle, enable them with the dedicated script (never `npm run build`):
#     npm run build:test        # sets VITE_ENABLE_TEST_LOGIN=true inline
# Do NOT put VITE_ENABLE_TEST_LOGIN in any .env file — that risks leaking it into a
# production `npm run build`. Keep it inline in the build:test script only.
# Optional AI fallbacks (used when client settings are empty)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Semantic layer — starts automatically with the API server (npm run dev)
# Disable auto-start: SEMANTIC_LAYER_AUTO_START=false
# Use "auto" to bind a free port when 8090 is taken (default)
SEMANTIC_LAYER_URL=auto
# SEMANTIC_LAYER_URL=http://127.0.0.1:8090
SEMANTIC_LAYER_ENABLED=true
SEMANTIC_LAYER_AUTO_START=true
SEMANTIC_INFERENCE_BACKEND=ollama
SEMANTIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave tier models empty or set to "auto" to discover from installed Ollama models at startup
SEMANTIC_TIER_SMALL_MODEL=
SEMANTIC_TIER_MEDIUM_MODEL=
SEMANTIC_TIER_LARGE_MODEL=
